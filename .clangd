# The PROS CLI writes a duplicate compile_commands.json entry with no standard
# library include paths (and --std=gnu++26), which clangd picks first and then
# reports "'string' file not found". Force the correct flags for C++ files.
If:
  PathExclude: .*\.c$
CompileFlags:
  Remove: [--std=*, -std=*]
  Add:
    - --std=gnu++23
    - -isystemC:/Users/osonw/AppData/Roaming/Code/User/globalStorage/sigbots.pros/install/pros-toolchain-windows/usr/arm-none-eabi/include/c++/13.3.1
    - -isystemC:/Users/osonw/AppData/Roaming/Code/User/globalStorage/sigbots.pros/install/pros-toolchain-windows/usr/arm-none-eabi/include/c++/13.3.1/arm-none-eabi/thumb/v7-a+simd/hard
    - -isystemC:/Users/osonw/AppData/Roaming/Code/User/globalStorage/sigbots.pros/install/pros-toolchain-windows/usr/arm-none-eabi/include/c++/13.3.1/backward
    - -isystemC:/Users/osonw/AppData/Roaming/Code/User/globalStorage/sigbots.pros/install/pros-toolchain-windows/usr/lib/gcc/arm-none-eabi/13.3.1/include
    - -isystemC:/Users/osonw/AppData/Roaming/Code/User/globalStorage/sigbots.pros/install/pros-toolchain-windows/usr/lib/gcc/arm-none-eabi/13.3.1/include-fixed
    - -isystemC:/Users/osonw/AppData/Roaming/Code/User/globalStorage/sigbots.pros/install/pros-toolchain-windows/usr/arm-none-eabi/include
